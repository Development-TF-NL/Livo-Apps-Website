# Whitepaper-lead-flow (besluit-lead-flow-whitepaper-v1).
# Zet deze variabelen in Vercel (Project Settings → Environment Variables).

# Poort: pas op 'true' zetten als de minimale privacyverklaring live staat (SenS-traject).
WHITEPAPER_FORM_ENABLED=false

# Poort prijspagina (fase C): pas op 'true' zetten als de concurrentie-offertes binnen
# zijn en de vergelijkingsclaim geverifieerd is. Poort dicht = 404 + noindex + niet in
# de sitemap. Bij het openen: ook Pricing terug in de nav (code) en redeploy.
PRICING_PAGE_ENABLED=false

# Pas op 'true' zetten na vrijgave van de publieke bestelroute en betaling.
# Dan leiden maandplannen naar de app; jaarbetaling en Custom blijven contactroutes.
# Wijziging van deze bouwvariabele vereist een nieuwe deploy.
SELF_SERVICE_ORDER_ENABLED=false

# Pas op 'true' zetten als ook de jaarbetaling via /order?period=yearly op productie is getest (29 oktober 2026:
# de app meldt bij jaarbetaling nog "needs a separate payment arrangement"). Tot die tijd blijft jaarbetaling een contactroute.
SELF_SERVICE_ANNUAL_ORDER_ENABLED=false

# Maandactie "Probeer het een maand" (brief 29 oktober 2026, §4): pas op 'true' zetten als aanbod, bestelreview,
# orderbevestiging, opzegproces en de voorwaarden (AV art. 6.5) dezelfde regel voor de eerste betaalde maand dragen.
# Uit = de standaardtermijn (30 dagen opzegtermijn) in hero, prijspagina en zoekresultaattekst.
MONTH_OFFER_ENABLED=false

# Publieke downloadlink van de whitepaper-PDF (na SenS-leestoets publiceren).
WHITEPAPER_DOWNLOAD_URL=

# Scaleway Transactional Email (afzender support@livoapps.software).
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_TEM_REGION=fr-par

# Attio CRM: lijst "Whitepaper leads" (lijst-ID uit de Attio-URL of API).
ATTIO_API_KEY=
ATTIO_WHITEPAPER_LIST_ID=
